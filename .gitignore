## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (Mono Auto Generated Files)
mono_crash.*

# Build results
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Uncomment if you have tasks that create the project's static files in wwwroot
# wwwroot/

# Visual Studio cache/options directory
.vs/

# Visual Studio 2019/2022 temp build files
Generated\ Files/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# Nunit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Build results of VS2015+
*.dbmdl
*.bak
*.backup
*.ldf
*.mdf

# SQL Server files
*.mdf
*.ldf

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# Tye
.tye/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# StyleCop
StyleCopReport.xml

# Files built by Visual Studio
*_i.c
*_p.c
*_h.h
*.ilk
*.meta
*.obj
*.iobj
*.pch
*.pdb
*.ipdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlh
*.tli
*.tmp
*.tmp_proj
*.log
*.vspscc
*_i.asm
*_p.asm
*.cache
*.dll
*.exe

# Others
*.bak
*.swp
*.ncb
*.sdf
*.opensdf
*.cachefile
*.dbmdl
*.dbproj.schemaview
*.jfm

# Visual Studio profiler
*.psess
*.vsp
*.vspx
*.sap

# TFS 2012 Local Workspace
$tf/

# Rider
.idea/
*.sln.iml

# Visual Studio Code
.vscode/
.history/
*.code-workspace

# DotCover
.idea/.idea.DotSettings.user
*.dotCover

# Windows image file caches
Thumbs.db
ehthumbs.db

# JetBrains Rider and ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Entity Framework
Migrations/obj/
Migrations/bin/

# Secrets & environment files
appsettings.json
appsettings.Development.json
appsettings.Local.json
*.secret.json
*.env
.env.local
.env.development.local
.env.production.local

# Publish output
publish/
out/
dist/

# Node (if you use React/Angular in same repo)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# Backup & generated files
*.bak
*.orig
*.rej

# macOS files
.DS_Store
.AppleDouble
.LSOverride

# Windows Installer files
*.cab
*.msi
*.msm
*.msp

# Temporary folders
~$*
